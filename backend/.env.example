# ============================================================================
# Arabtec Recruitment Hub — environment template
# Copy to `.env` and fill in. NEVER commit a real .env or real secret values.
# Full reference: docs/ENVIRONMENT_VARIABLES.md
# ============================================================================

# --- Database -------------------------------------------------------------
# Local dev (default, zero-setup): SQLite. Start with `npm run start:sqlite`.
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL. Example:
#   DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/arabtec?sslmode=require"
# Optional Postgres tuning:
# PG_ENGINE=              # set to "pglite" only for in-process Postgres verification
# PG_DATA=                # data dir when PG_ENGINE=pglite (persistence)
# PG_NO_SSL=              # "true" to disable TLS (localhost/self-hosted same box only)

# --- Auth / sessions ------------------------------------------------------
# REQUIRED in production. Use a long (32+ char) random string. The app refuses
# to start in production without it. Generate: `openssl rand -hex 32`.
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="2h"
JWT_REMEMBER_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10
# Account lockout after this many consecutive failed logins:
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# --- Server / networking --------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated allowed CORS origins (the browser app's public URL(s)).
# UPDATE THIS to the custom domain at go-live, e.g. https://ats.arabtec-hr.com
CORS_ORIGINS="http://localhost:5173,http://localhost:4000,http://127.0.0.1:4000"
# Number of proxy hops to trust for req.ip (prevents X-Forwarded-For spoofing).
# Production behind Render/Coolify/Nginx = 1. Local dev = leave unset (off).
TRUST_PROXY=1
# Global API rate limiter (per IP):
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=true   # tests only

# --- Security headers -----------------------------------------------------
# HSTS is sent only when NODE_ENV=production. Max-age in seconds (default 180d).
HSTS_MAX_AGE=15552000
# Roll out CSP safely by observing violations first (does not block):
# CSP_REPORT_ONLY=true
# SECURITY_HEADERS_DISABLED=true   # debugging escape hatch — NEVER in production

# --- Seed admin (used only by the first-run seed) -------------------------
# In production leave SEED_ADMIN_PASSWORD BLANK so a strong random one is
# generated and printed ONCE; the admin must rotate it at first login.
SEED_ADMIN_EMAIL="admin@arabtec.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="System Administrator"
# SEED_DEMO_DATA=false   # true only in local/staging to seed demo users

# --- Microsoft 365 careers mailbox (delegated OAuth) ----------------------
# A System Admin signs in ONCE as career@arabtecegy.com from
# Configuration -> Microsoft 365 in the app. MSAL then keeps the connection
# alive silently; there is no daily interactive login.
#
# Delegated Graph scopes only: openid, profile, offline_access, Mail.Read,
# Mail.Send. NO application permissions, NO .default, NO Mail.ReadWrite.
# Setup steps: docs/MICROSOFT_365_INTEGRATION.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=career@arabtecegy.com
# Must match a Web redirect URI on the Entra app registration EXACTLY.
# Derived from the first CORS_ORIGINS entry when left blank.
# Entra accepts https:// (or http://localhost for local development only).
MS_REDIRECT_URI=
# AES-256-GCM key encrypting the MSAL token cache at rest. REQUIRED whenever the
# variables above are set — the app refuses to start without it.
#   openssl rand -hex 32
# NEVER commit a real value. Changing it invalidates the stored connection.
MICROSOFT_TOKEN_ENCRYPTION_KEY=
# Optional tuning:
# MS_SYNC_OVERLAP_MIN=10   # how far a scan reaches back past the last success
# MS_SYNC_BATCH=50         # messages examined per pass

# --- Email ----------------------------------------------------------------
# Provider order: dry-run (SMTP_TRANSPORT=json) > Microsoft Graph > SMTP.
#   auto  (default) Graph when the Microsoft connection is healthy, else SMTP
#   graph           Graph only; never falls back to SMTP
#   smtp            SMTP only; ignores the Microsoft connection
MAIL_PROVIDER=auto
MAIL_FROM_NAME="Arabtec Careers"
#
# SMTP is the FALLBACK. Leave USER/PASS blank to keep it off — with Microsoft 365
# connected nothing here is needed, and no mailbox password is stored anywhere.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMTP_TRANSPORT=json   # dry-run: build emails without sending (tests only)

# --- AI CV parsing — leave keys blank to use the heuristic parser ---------
# DeepSeek / SiliconFlow (used by the CV folder watcher):
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"
# Anthropic (used by the on-demand CV parser). Requires @anthropic-ai/sdk installed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# --- Uploads / file storage ----------------------------------------------
# Persistent directory for uploaded files. On VPS/Coolify point this at a mounted
# volume. If unset, files are stored durably in the DB blob table (see docs).
UPLOAD_DIR=

# --- CV inbox folder watcher (feature.folder_watcher) ---------------------
CV_INBOX=
CV_WATCH_INTERVAL_MIN=60

# --- Monitoring / error tracking ------------------------------------------
# Set to enable Sentry error tracking in production (do NOT commit the value):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Document understanding pipeline (Phase 4). Placeholders only. ---
# Docling sidecar. Unset = the local pdfjs/mammoth parser is used instead.
DOCLING_BASE_URL=
DOCLING_TIMEOUT_MS=120000
DOCLING_PIPELINE_VERSION=
# OCR engine. Provider-neutral: PaddleOCR, OpenOCR or any HTTP OCR service.
# Unset = pages needing OCR are marked degraded rather than silently empty.
OCR_BASE_URL=
OCR_ENGINE=
OCR_PATH=/ocr
OCR_TIMEOUT_MS=60000
# Local/private Ollama for résumé extraction and competency evaluation.
# Unset = deterministic rules only (a complete, valid deployment).
# NOTE: the client sends no Authorization header today; a remote endpoint needs
# token support added before it can be used safely.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
