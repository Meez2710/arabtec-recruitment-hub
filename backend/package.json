{
  "name": "arabtec-recruitment-hub-backend",
  "version": "1.0.0",
  "description": "Arabtec Recruitment Hub backend (auth, RBAC, requests, candidates, interviews, offers, dashboards, ticket threads, audit). Dual database: SQLite (local) / PostgreSQL (production).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:sqlite": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "seed": "node --experimental-sqlite prisma/seed.js",
    "setup": "node --experimental-sqlite prisma/seed.js",
    "reset": "node -e \"require('fs').rmSync('./prisma/dev.db',{force:true})\" && node --experimental-sqlite prisma/seed.js",
    "test": "node --experimental-sqlite run_tests.mjs",
    "test:domain": "vitest run",
    "test:domain:watch": "vitest",
    "test:domain:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "reconcile": "tsx src/infrastructure/tools/reconcile/run.ts",
    "test:pg": "vitest run --no-file-parallelism",
    "test:pg:legacy": "node pg_tx_test.mjs",
    "test:pg:required": "node pg_tx_test.mjs --required && node pg_appnumber_race_test.mjs && node pg_sequence_test.mjs && node pg_reopen_race_test.mjs && node reconciliation_test.mjs && node pg_headcount_race_test.mjs && node pg_join_race_test.mjs",
    "test:cluster": "node pg_cluster_test.mjs --own",
    "api": "tsx src/api/main.ts",
    "api:dev": "tsx watch src/api/main.ts"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@sentry/node": "^8.47.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.28.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
