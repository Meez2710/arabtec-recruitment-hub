# would let a stale build ship alongside changed sources.
backend/dist/
*.log
.env
.env.*
!.env.example
backend/.env
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db-wal
backend/prisma/*.db-shm
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
.DS_Store
.fuse_hidden*
*.fuse_hidden*
Thumbs.db
.netlify/
backend/dbg*.mjs
backend/_*.mjs
backend/launch_check.mjs

# Local static ATS review mockup; reference copy is stored under docs/ui-review/
frontend/public/ats-full-review.html
# Rendered live-test fixtures are generated on the host, not committed as binaries.
backend/live-fixtures/*.pdf
backend/live-fixtures/*.png

# Local pilot secrets and venv — never committed.
deploy/docling-sidecar/.env.local
deploy/docling-sidecar/.venv
logs/
deploy/docling-sidecar/__pycache__/

# Confidential user-credential handover artefacts. Generated on the server into
# /var/lib/arabtec-ats/handover/ — these patterns are a backstop in case a copy
# ever lands inside the repo. NEVER commit plaintext credentials or the private
# handover manual.
**/handover/
temporary-credentials-*
credentials-map-*
Arabtec_ATS_User_Manual_Internal_Handover*
# On-prem env files (secrets) — templates (*.template) stay tracked.
deploy/on-prem/ats.env
deploy/on-prem/scan.env
