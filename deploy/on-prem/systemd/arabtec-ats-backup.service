[Unit]
Description=Arabtec ATS — nightly database + uploads backup
After=arabtec-ats.service postgresql.service

[Service]
Type=oneshot
User=ats
Group=ats
# ats.env holds DATABASE_URL and UPLOAD_DIR, which backup.sh needs.
EnvironmentFile=/etc/arabtec-ats/ats.env
ExecStart=/bin/bash /opt/arabtec-ats/deploy/on-prem/backup.sh
StandardOutput=journal
StandardError=journal
# backup.sh writes here; ProtectSystem=strict otherwise makes it read-only.
ProtectSystem=strict
ReadWritePaths=/var/backups/arabtec-ats
