# /etc/arabtec-ats/ats.env      chmod 600, owner root:root
# Secrets live ONLY here. Never in the repo, never in a systemd unit.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# --- core (required) ---
NODE_ENV=production
PORT=4001                                   # 4000 may belong to Employee Workspace; confirm with 00-inspect
DATABASE_URL=postgres://arabtec_ats:REPLACE_ME@127.0.0.1:5432/arabtec_ats
JWT_SECRET=REPLACE_ME                        # openssl rand -hex 32
TRUST_PROXY=1                               # exactly one hop: Apache
CORS_ORIGINS=https://REPLACE_ME             # the exact URL staff type, e.g. https://ats.arabtec.local

# --- persistent storage (absolute paths; survive redeploys) ---
UPLOAD_DIR=/var/lib/arabtec-ats/uploads
CV_INBOX=/var/lib/arabtec-ats/cv_inbox      # point at the HR share, or a mount of it (read-only is fine)

# --- CV scanner ---
# 0 disables the in-process interval poller. The daily 08:00 Africa/Cairo run is
# a systemd timer (arabtec-cv-scan.timer) instead — the built-in watcher is an
# interval poller and cannot express a wall-clock schedule.
CV_WATCH_INTERVAL_MIN=0

# --- Anthropic (powers CV parsing, talent search, AI shortlist) ---
ANTHROPIC_API_KEY=REPLACE_ME
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # ~5x cheaper/faster than the opus default; good for bulk inbox scans

# --- Microsoft 365 careers mailbox (delegated OAuth) ---
# One System Admin signs in ONCE as career@arabtecegy.com at
# Configuration > Microsoft 365 in the ATS. No tenant-wide Graph application
# permission, no Exchange application access policy, no PowerShell, no SMTP
# password. Entra setup: docs/MICROSOFT_365_INTEGRATION.md
MS_TENANT_ID=REPLACE_ME                     # Directory (tenant) ID
MS_CLIENT_ID=REPLACE_ME                     # Application (client) ID
MS_CLIENT_SECRET=REPLACE_ME                 # client secret VALUE (not the secret ID)
MS_MAILBOX=career@arabtecegy.com            # the ONLY account allowed to connect
# Must match a Web redirect URI on the app registration EXACTLY, and Entra only
# accepts https:// — finish the Apache TLS vhost before connecting.
MS_REDIRECT_URI=https://REPLACE_ME/api/integrations/microsoft/callback
# AES-256-GCM key for the MSAL token cache at rest.  openssl rand -hex 32
# Rotating it invalidates the stored connection: reconnect after a change.
MICROSOFT_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# --- email ---
# With Microsoft 365 connected, outgoing mail goes through Graph
# (POST /me/sendMail) on that same delegated grant — no SMTP password needed.
# MAIL_PROVIDER=auto        # auto (default) = Graph when healthy, else SMTP
# MAIL_FROM_NAME=Arabtec Recruitment
#
# SMTP is the FALLBACK only, and only if these are set. Leave unset to keep it off.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=recruitment@arabtec.com

# --- first boot only; only used when the DB is empty. Remove after the admin
#     password is rotated. Skip entirely if you imported the Render database. ---
# SEED_ADMIN_EMAIL=admin@arabtec.com
# SEED_ADMIN_PASSWORD=

# --- error tracking (optional) ---
# SENTRY_DSN=
