# /etc/arabtec-ats/ats.env      chmod 600, owner root:root
# Secrets live ONLY here. Never in the repo, never in a systemd unit.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# --- core (required) ---
NODE_ENV=production
PORT=4001                                   # 4000 may belong to Employee Workspace; confirm with 00-inspect
DATABASE_URL=postgres://arabtec_ats:REPLACE_ME@127.0.0.1:5432/arabtec_ats
JWT_SECRET=REPLACE_ME                        # openssl rand -hex 32
TRUST_PROXY=1                               # exactly one hop: Apache
CORS_ORIGINS=https://REPLACE_ME             # the exact URL staff type, e.g. https://ats.arabtec.local

# --- persistent storage (absolute paths; survive redeploys) ---
UPLOAD_DIR=/var/lib/arabtec-ats/uploads
CV_INBOX=/var/lib/arabtec-ats/cv_inbox      # point at the HR share, or a mount of it (read-only is fine)

# --- CV scanner ---
# 0 disables the in-process interval poller. The daily 08:00 Africa/Cairo run is
# a systemd timer (arabtec-cv-scan.timer) instead — the built-in watcher is an
# interval poller and cannot express a wall-clock schedule.
CV_WATCH_INTERVAL_MIN=0

# --- Anthropic (powers CV parsing, talent search, AI shortlist) ---
ANTHROPIC_API_KEY=REPLACE_ME
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # ~5x cheaper/faster than the opus default; good for bulk inbox scans

# --- Microsoft 365 careers mailbox (delegated OAuth, INTAKE ONLY) ---
# One person signs in ONCE with a device code. No tenant-wide Graph application
# permission, no Exchange application access policy, no PowerShell, no SMTP
# password, and — in device-code mode — no client secret and no HTTPS callback,
# so this host needs no certificate and no DNS name to be connected.
# Entra setup and the exact sign-in procedure: docs/MICROSOFT_365_INTEGRATION.md
MS_TENANT_ID=REPLACE_ME                     # Directory (tenant) ID
MS_CLIENT_ID=REPLACE_ME                     # Application (client) ID
MS_MAILBOX=career@arabtecegy.com            # the ONLY mailbox this may read

# device-code (default when no secret is set) | auth-code
# device-code uses an MSAL PUBLIC client. Do NOT also set MS_CLIENT_SECRET:
# Entra rejects a client_secret from an app registered as a public client.
MS_AUTH_MODE=device-code

# own (default) | shared
#   own    — the account signing in IS career@arabtecegy.com. Scope: Mail.Read,
#            Graph reads /me, and the token reaches exactly that one mailbox.
#   shared — career@arabtecegy.com is a SHARED mailbox that cannot sign in, so an
#            already-authorized person signs in as themselves. Scope widens to
#            Mail.Read.Shared, which grants "any mailbox this user may open" —
#            the ATS narrows that back to one by reading /users/<MS_MAILBOX>
#            and nothing else. Use `own` unless sign-in genuinely fails.
MS_MAILBOX_ACCESS=own

# Outgoing mail through Graph is OFF unless this is true, and the scope request
# follows it: with this false, Mail.Send is never asked for and the mailer will
# not select Graph. Leave it false for a CV-intake-only deployment.
MS_ENABLE_SEND=false

# AES-256-GCM key for the MSAL token cache at rest.  openssl rand -hex 32
# Rotating it invalidates the stored connection: reconnect after a change.
MICROSOFT_TOKEN_ENCRYPTION_KEY=REPLACE_ME

# auth-code mode ONLY — leave both unset for device-code.
# MS_CLIENT_SECRET=REPLACE_ME               # client secret VALUE (not the secret ID)
# Must match a Web redirect URI on the app registration EXACTLY. Entra accepts
# https:// and, as a documented exception, http://localhost — so an internal-only
# host can use http://localhost:4001/... reached over an SSH tunnel instead of
# waiting for the TLS vhost.
# MS_REDIRECT_URI=https://REPLACE_ME/api/integrations/microsoft/callback

# --- email ---
# With Microsoft 365 connected AND MS_ENABLE_SEND=true, outgoing mail goes
# through Graph (POST /me/sendMail) on that same delegated grant — no SMTP
# password needed. With MS_ENABLE_SEND=false (the intake-only default) Graph is
# never selected for sending, so SMTP below is the only outgoing path.
# MAIL_PROVIDER=auto        # auto (default) = Graph when healthy, else SMTP
# MAIL_FROM_NAME=Arabtec Recruitment
#
# SMTP is the FALLBACK only, and only if these are set. Leave unset to keep it off.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=recruitment@arabtec.com

# --- first boot only; only used when the DB is empty. Remove after the admin
#     password is rotated. Skip entirely if you imported the Render database. ---
# SEED_ADMIN_EMAIL=admin@arabtec.com
# SEED_ADMIN_PASSWORD=

# --- error tracking (optional) ---
# SENTRY_DSN=
