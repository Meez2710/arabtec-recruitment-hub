# /etc/arabtec-ats/mailbox.env     chmod 600, owner arabtec-ats:arabtec-ats
# Read by arabtec-cv-mailbox.service. Secrets live ONLY here.

# --- Microsoft 365 app registration (client-credentials) ---
MB_TENANT_ID=REPLACE_ME              # Directory (tenant) ID
MB_CLIENT_ID=REPLACE_ME              # Application (client) ID
MB_CLIENT_SECRET=REPLACE_ME          # client secret VALUE (not the secret ID)

# --- which mailbox / folders ---
MB_MAILBOX=careers@arabtecegy.com    # the shared careers mailbox to read
MB_SOURCE_FOLDER=Inbox              # well-known name or a folder displayName
MB_PROCESSED_FOLDER=Processed-ATS   # handled mail is moved here (created if missing); blank = don't move
MB_MARK_READ=true

# --- what to pull ---
MB_EXT=.pdf,.docx,.doc
MB_MAX_MB=20                        # matches the app's 20 MB upload cap
MB_BATCH=50

# --- where the ATS looks (must match CV_INBOX in /etc/arabtec-ats/ats.env) ---
CV_INBOX=/var/lib/arabtec-ats/cv_inbox

# --- OPTIONAL: import immediately instead of waiting for the folder watcher ---
# Needs a dedicated ATS account holding ONLY the candidate.add permission.
# MB_TRIGGER_SCAN_URL=http://127.0.0.1:4001
# MB_SCAN_EMAIL=cv.scanner@arabtec.com
# MB_SCAN_PASSWORD=REPLACE_ME
