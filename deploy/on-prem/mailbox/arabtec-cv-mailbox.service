[Unit]
Description=Arabtec ATS — pull CV attachments from the careers mailbox into CV_INBOX
After=network-online.target arabtec-ats.service
Wants=network-online.target

[Service]
Type=oneshot
User=arabtec-ats
Group=arabtec-ats
EnvironmentFile=/etc/arabtec-ats/mailbox.env
ExecStart=/usr/bin/node /opt/arabtec-ats/deploy/on-prem/mailbox/cv-mailbox-sync.mjs
StandardOutput=append:/var/log/arabtec-ats/cv-mailbox.log
StandardError=append:/var/log/arabtec-ats/cv-mailbox.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/arabtec-ats /var/log/arabtec-ats
