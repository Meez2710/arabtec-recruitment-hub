# /etc/arabtec-ats/scan.env     chmod 600, owner arabtec-ats:arabtec-ats
# Read by arabtec-cv-scan.service (the 08:00 Africa/Cairo CV folder scan).

ATS_URL=http://127.0.0.1:4001          # must match PORT in ats.env

# A DEDICATED service account that holds the `candidate.add` permission and
# NOTHING else. Do not reuse a person's login. Create it in the app under
# Settings -> Users with a role limited to candidate.add, then put its
# credentials here.
SCAN_EMAIL=cv.scanner@arabtec.com
SCAN_PASSWORD=REPLACE_ME
