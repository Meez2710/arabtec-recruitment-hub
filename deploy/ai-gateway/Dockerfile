# Arabtec private AI gateway — Docling + Ollama/Qwen, RunPod Secure Cloud.
#
# WHY ONE IMAGE AND NOT THREE SERVICES. Docling and Ollama both speak
# unauthenticated HTTP and are designed for loopback. Splitting them across
# network boundaries would mean either exposing them or building mutual TLS
# between them. Co-locating them behind ONE authenticated gateway keeps both on
# 127.0.0.1 and leaves exactly one door, which is the door we can defend.
#
# EVERYTHING IS PINNED BY DIGEST. A staging result that cannot be reproduced is
# not evidence. `python:3.11-slim` moves; the digest below does not. Refresh it
# deliberately with the procedure in docs/AI_RUNTIME_DEPLOYMENT.md — never with
# a floating tag.
#
# NOTHING LISTENS PUBLICLY EXCEPT THE GATEWAY. Ollama is bound to loopback via
# OLLAMA_HOST and the Docling sidecar to 127.0.0.1. Port 11434 is never
# EXPOSEd, never published, and never reachable from outside the container.

# python:3.11-slim-bookworm — digest RESOLVED 2026-08-09 from
# registry-1.docker.io, not invented. The previous value here was a fabricated
# placeholder that would never have pulled; a digest that cannot resolve is
# worse than a tag, because it looks rigorous.
#
# Kept in sync with versions.env BASE_IMAGE_REF; check-pins.sh asserts they
# match. Refresh procedure in docs/AI_RUNTIME_DEPLOYMENT.md — never a tag.
FROM python@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Loopback only. This single variable is what keeps the model runtime off
    # the network; do not override it in the RunPod template.
    OLLAMA_HOST=127.0.0.1:11434 \
    # Weights and Docling models live on the persistent volume, not the image:
    # a 5 GB layer would make every deploy a re-download.
    OLLAMA_MODELS=/workspace/models/ollama \
    HF_HOME=/workspace/models/hf \
    DOCLING_ARTIFACTS_PATH=/workspace/models/docling \
    GATEWAY_PORT=8080 \
    DOCLING_PORT=8089

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates tini \
      # OCR rescue path. Arabic is included because Gulf CVs routinely mix
      # scripts and an English-only OCR silently drops half a scanned page.
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-ara \
      poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Ollama, pinned to the version Stage 2 Run 1 actually measured. The install
# script follows "latest" by design, so the version is asserted afterwards and
# the build fails rather than drifting.
ARG OLLAMA_VERSION=0.32.6
RUN curl -fsSL https://ollama.com/install.sh | OLLAMA_VERSION=${OLLAMA_VERSION} sh \
    && ollama --version | grep -q "${OLLAMA_VERSION}"

WORKDIR /srv

# Hash-pinned dependency install. requirements.txt is generated by lock.sh
# inside THIS base image; until it has been, the file carries a deliberate
# error marker and this step fails. That is the intended behaviour — an
# unlocked dependency tree in a CV-processing image is not an acceptable
# default. See the header of requirements.txt.
COPY requirements.txt ./
RUN pip install --require-hashes -r requirements.txt

# OCR ASSETS ARE BAKED IN AT BUILD TIME.
#
# Stage 2 Run 1 recorded Docling downloading RapidOCR PP-OCRv6 weights from
# modelscope.cn during the FIRST conversion. That is a runtime network call on
# the CV path and it voids the offline guarantee. Everything the OCR engine
# needs is fetched and checksum-verified here instead.
#
# This step FAILS while any checksum in ocr-assets.lock is still __RECORD__.
# Populate them with `./fetch-ocr-assets.sh --record <dir>` and commit the
# result; the failure is the guard, not a bug.
ENV OCR_ASSETS_DIR=/opt/ocr-assets
COPY ocr-assets.lock fetch-ocr-assets.sh ./
RUN chmod +x fetch-ocr-assets.sh \
    && ./fetch-ocr-assets.sh "${OCR_ASSETS_DIR}"

# Assert the Docling API surface this runtime depends on BEFORE the image is
# considered good. docling moved 2.15 -> 2.55 -> 2.118 across this repo's
# config files; a version that installs is not a version that is compatible.
COPY compat_check.py ./
RUN python compat_check.py

# Materialise the RapidOCR weights and verify every byte against the recorded
# lock. Done here, once, with the network available — after this the runtime
# has a populated cache and reaches nothing. Fails closed if a weight is
# missing or its checksum moved.
COPY warm_ocr_assets.py ocr-models.lock ./
RUN python warm_ocr_assets.py --mode verify \
      --dir "${OCR_ASSETS_DIR}/models" --lock ocr-models.lock \
    && printf 'asset=models\n' >> "${OCR_ASSETS_DIR}/MANIFEST"

COPY gateway.py docling_sidecar.py resource_probe.py entrypoint.sh ./
RUN chmod +x entrypoint.sh

# Runs as a non-root user: a document-parsing service processes untrusted input
# from the internet by definition.
RUN useradd --create-home --uid 10001 gateway \
    && mkdir -p /workspace/models \
    && chown -R gateway:gateway /srv /workspace \
    # Read-only to the runtime user: the OCR assets are build output and a
    # process handling untrusted documents has no reason to be able to rewrite
    # the models it is about to run.
    && chown -R root:root "${OCR_ASSETS_DIR}" && chmod -R a+rX "${OCR_ASSETS_DIR}"
USER gateway

# ONLY the gateway. Not 11434, not 8089.
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["./entrypoint.sh"]
