# Single source of truth for every version the AI runtime image depends on.
#
# WHY THIS FILE EXISTS. Versions were previously scattered across three files
# and disagreed: the gateway pinned docling 2.15.1, the sidecar 2.55.1, and the
# pod actually ran 2.118.1. A benchmark result is worthless if you cannot say
# which code produced it.
#
# NOTHING HERE MAY BE `latest`, a floating tag, or a range. Every value is
# either an exact version or a content digest. CI asserts this
# (see check-pins.sh).
#
# Sourced by: Dockerfile (via --build-arg), lock.sh, fetch-ocr-assets.sh,
# stage2_benchmark.py, and check-pins.sh.

# ---------------------------------------------------------------- base image
# python:3.11-slim-bookworm, resolved 2026-08-09 from registry-1.docker.io.
# Refresh deliberately: re-resolve, rebuild, re-run the Stage 2 benchmark, and
# only then commit the new digest. Never edit this to a tag.
BASE_IMAGE_REF=python@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
BASE_IMAGE_HUMAN=python:3.11-slim-bookworm

# ---------------------------------------------------------------- inference
# Measured on the Stage 2 pod, Run 1. The install script follows "latest" by
# design, so the Dockerfile asserts this version afterwards and fails the build
# rather than drifting.
OLLAMA_VERSION=0.32.6

# Model identity. The digest is what makes a result reproducible — the tag
# alone is mutable upstream.
#
# NOTE: the digest below is the 12-character short form reported by
# `/api/tags` during Run 1. Run 2 records the full sha256 and this line is
# replaced with it; check-pins.sh warns while it is still short.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_DIGEST_SHORT=845dbda0ea48
OLLAMA_MODEL_QUANT=Q4_K_M
OLLAMA_MODEL_SIZE_BYTES=4683087332

# ---------------------------------------------------------------- docling
# PROPOSED, NOT ACCEPTED. 2.118.1 is what Run 1 measured, but Run 1 installed it
# ad hoc with no compatibility check against the sidecar's API usage
# (PdfPipelineOptions.artifacts_path, do_ocr, ocr_options, page provenance).
#
# compat_check.py asserts that surface and runs during the image build. Until
# that build passes, treat this as a candidate.
DOCLING_VERSION=2.118.1
DOCLING_PIN_STATUS=candidate-pending-compat-check

# ---------------------------------------------------------------- OCR engine
# Docling 2.118 defaults to RapidOCR, which is what reached modelscope.cn during
# Run 1. Assets are pinned and pre-fetched; see ocr-assets.lock.
OCR_ENGINE=rapidocr
OCR_ASSETS_DIR=/opt/ocr-assets

# ---------------------------------------------------------------- fixtures
# OFL-1.1 licensed Arabic-capable font, needed to generate synthetic Arabic
# PDFs with embedded glyphs. Verified by checksum at build time.
FIXTURE_FONT_NAME=NotoNaskhArabic-Regular.ttf
