# Direct dependencies only. Versions exact, never ranges.
#
# This file is the INPUT. The thing the image installs is requirements.txt,
# which is fully resolved and hash-pinned and is generated by lock.sh inside
# the pinned base image — resolving on a developer laptop produces the wrong
# wheels for the wrong platform and Python version.
#
# Adding a dependency here without re-running lock.sh will fail the build,
# because pip --require-hashes refuses anything absent from the lock.

# Document intelligence. Version is a CANDIDATE until compat_check.py passes in
# the image build; see versions.env DOCLING_PIN_STATUS.
docling==2.118.1

# RapidOCR's inference engine. docling pulls in rapidocr, but rapidocr declares
# onnxruntime as an OPTIONAL extra, so the resolver never selected it. At
# runtime RapidOCR chose engine_name=onnxruntime and every OCR rescue died with
# a bare ImportError — the whole scanned-document path was silently broken
# while digital documents looked fine. compat_check.py now asserts the import.
onnxruntime==1.28.0

# HTTP client used by the gateway to reach the loopback sidecar and Ollama.
requests==2.32.3

# Synthetic fixture generation: Arabic-capable PDF output with embedded fonts.
# Build-time and benchmark-time only, never on the request path.
reportlab==4.2.5
arabic-reshaper==3.0.0
python-bidi==0.6.3

# Image rasterisation for scanned-document fixtures.
pillow==11.0.0
