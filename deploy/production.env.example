# ============================================================================
# Arabtec ATS — PRODUCTION environment template
#
# Copy to /etc/arabtec/ats.env on the application host, fill in the values
# marked SUPPLY, and lock it down:
#
#     sudo install -m 600 -o arabtec -g arabtec production.env.example \
#          /etc/arabtec/ats.env
#
# NEVER commit a filled-in copy. This file contains no real values and must
# stay that way.
#
# Legend:
#   SUPPLY  — the deployment environment must provide this; there is no default
#   FIXED   — use exactly this value in production
#   TUNE    — a sensible default you may change with reason
# ============================================================================

# --- Database -------------------------------------------------------------
# SUPPLY. PostgreSQL only. SQLite is development-only and is not supported here.
# sslmode=require unless PostgreSQL is on this same host over a unix socket.
DATABASE_URL=

# --- Auth / sessions ------------------------------------------------------
# SUPPLY. 32+ characters. The application REFUSES TO START in production
# without it. Generate with:  openssl rand -hex 32
# Changing it invalidates every existing session — that is intended.
JWT_SECRET=

# TUNE.
JWT_EXPIRES_IN=2h
JWT_REMEMBER_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# --- Server / networking --------------------------------------------------
# FIXED. Anything else disables HSTS, enables dev CORS fallbacks, and seeds
# demo users.
NODE_ENV=production

# TUNE. The port Apache proxies to. Keep it bound to localhost (see runbook).
PORT=4000

# FIXED at 1 when exactly one reverse proxy (Apache) sits in front. This is
# what stops a client spoofing X-Forwarded-For to forge req.ip and bypass the
# per-IP rate limiter. More proxies (e.g. a CDN) = the real number of hops.
TRUST_PROXY=1

# SUPPLY. The browser-facing origin(s), comma-separated, scheme included.
# Cross-origin requests from anything not listed are denied in production.
CORS_ORIGINS=

# TUNE. Global per-IP API rate limit.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# TUNE. HSTS max-age in seconds (default 180 days). Sent only in production.
HSTS_MAX_AGE=15552000

# --- Seeding --------------------------------------------------------------
# FIXED. Demo users share a published password. They must never exist in
# production.
SEED_DEMO_DATA=false

# SUPPLY (first boot only, then remove). The bootstrap administrator password.
# The account is created with must_change_password=1, so it is blocked from
# every route except /auth/me, /auth/change-password and /auth/logout until it
# is rotated. If you leave this unset a random password is generated and
# printed ONCE to the boot log.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_EMAIL=admin@arabtec.com

# --- Document parsing (Docling sidecar) -----------------------------------
# FIXED. `serve` selects the RunPod Docling Serve transport, which is
# implemented but NOT production-verified. Do not set it.
DOCLING_BACKEND=sidecar

# FIXED for a same-host sidecar. If this is unset the application falls back to
# the in-process pdfjs/mammoth parser: born-digital PDFs and DOCX keep working,
# and scanned CVs are refused explicitly rather than silently returning nothing.
DOCLING_BASE_URL=http://127.0.0.1:8089

# SUPPLY only if the sidecar is NOT on loopback. Empty means no Authorization
# header, which is safe only when the network boundary is doing the work.
# DOCLING_BEARER_TOKEN=

# TUNE. Client-side ceiling for one conversion.
DOCLING_TIMEOUT_MS=120000

# SUPPLY. The pinned sidecar image/config identifier, recorded on every
# proposal so a parse is reproducible. e.g. arabtec-docling-2.55.1-2026-08
# DOCLING_PIPELINE_VERSION=

# --- Uploads --------------------------------------------------------------
# SUPPLY. Persistent path. CV bytes are also stored in the database
# (file_blob), which is the source of truth; this is a local cache.
UPLOAD_DIR=/var/lib/arabtec/uploads

# --- Data protection ------------------------------------------------------
# TUNE. Retention enforcement is OFF unless this is exactly "true". Erasure is
# irreversible for the erased fields. Run with RETENTION_DRY_RUN=true first and
# review the report before enabling.
# RETENTION_ENFORCEMENT=true
# RETENTION_DRY_RUN=true
RETENTION_SWEEP_HOURS=24

# FIXED (leave unset). Required before the AI extractor may talk to a non-local
# Ollama host. Unset means candidate text cannot leave this machine.
# OLLAMA_ALLOW_REMOTE=

# --- Email (optional; leave blank to keep notifications off) --------------
# Set BOTH SMTP_USER and SMTP_PASS, or neither.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_FROM_NAME=Arabtec Recruitment

# --- Monitoring (optional) ------------------------------------------------
# Absent = error tracking disabled, application runs normally.
# SENTRY_DSN=

# ============================================================================
# Sidecar variables live in a SEPARATE file on the sidecar host —
# /etc/arabtec/docling.env — not here. See the deployment runbook §5.
#   SIDECAR_OCR_LANGS=eng,ara
#   SIDECAR_OCR_SCALE=4.0
# ============================================================================
